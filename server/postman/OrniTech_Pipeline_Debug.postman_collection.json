      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ─── Login Tests ───",
              "",
              "const res = pm.response.json();",
              "",
              "pm.test('✅ Login successful (200)', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('✅ JWT token returned', () => {",
