    {
      "name": "5. Create Project (triggers generation)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{projectTitle}}\",\n  \"prompt\": \"{{projectPrompt}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/projects",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects"]
        },
        "description": "## Create a project and trigger background generation\n\n**Method:** POST  \n**URL:** `{{baseUrl}}/api/projects`  \n**Auth:** Bearer `{{jwt}}`  \n\n**Body:**\n```json\n{\n  \"title\": \"Debug Hospital Website\",\n  \"prompt\": \"Create a premium hospital website for MedVista Health Center...\"\n}\n```\n\n**Expected Status:** 201  \n**Expected Response:**\n```json\n{\n  \"success\": true,\n  \"message\": \"Project created successfully.\",\n  \"data\": {\n    \"_id\": \"...\",\n    \"userId\": \"...\",\n    \"title\": \"Debug Hospital Website\",\n    \"prompt\": \"...\",\n    \"status\": \"PENDING\",\n    \"progress\": 0\n  }\n}\n```\n\nThis endpoint saves the project to MongoDB AND enqueues a BullMQ job for the worker."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ─── Create Project Tests ───",
              "",
              "const res = pm.response.json();",
              "",
              "pm.test('✅ Project created (201)', () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('✅ Success flag is true', () => {",
              "    pm.expect(res.success).to.be.true;",
              "});",
              "",
              "pm.test('✅ Project ID exists', () => {",
              "    pm.expect(res.data._id).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('✅ Initial status is PENDING', () => {",
              "    pm.expect(res.data.status).to.equal('PENDING');",
              "});",
              "",
              "pm.test('✅ Initial progress is 0', () => {",
              "    pm.expect(res.data.progress).to.equal(0);",
              "});",
              "",
              "// Save project ID and reset polling state",
              "pm.environment.set('projectId', res.data._id);",
              "pm.environment.set('lastProgress', '0');",
              "pm.environment.set('lastStatus', 'PENDING');",
              "pm.environment.set('pollCount', '0');",
              "",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('🚀 PROJECT CREATED — GENERATION PIPELINE STARTED');",
              "console.log('');",
              "console.log('  Project ID: ' + res.data._id);",
              "console.log('  Title:      ' + res.data.title);",
              "console.log('  Status:     ' + res.data.status);",
              "console.log('  Progress:   ' + res.data.progress + '%');",
              "console.log('  Created:    ' + res.data.createdAt);",
              "console.log('');",
              "console.log('  ⏳ Worker job has been enqueued.');",
              "console.log('  ⏳ Use \"Poll Project Status\" to watch progress.');",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');"
            ]
          }
        }
      ],
      "response": []
    },
