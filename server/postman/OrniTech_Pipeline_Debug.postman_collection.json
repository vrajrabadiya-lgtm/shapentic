          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "## Poll project status until COMPLETED or FAILED\n\n**Method:** GET  \n**URL:** `{{baseUrl}}/api/projects/{{projectId}}`  \n**Auth:** Bearer `{{jwt}}`  \n\n### How to use\n- **Manual:** Click Send repeatedly every 2-3 seconds\n- **Runner:** Use Postman Runner with a delay of 2000ms and set iterations to 40\n- **Monitor:** Watch the Console output for live status changes\n\n### Console Output Format\n```\n↓\nPROCESSING (40%)\nGenerating Components...\n```\n\n### Tracked Fields\n- Project ID\n- Status\n- Progress\n- Build Status\n- Blueprint (exists?)\n- Artifact / ZIP (exists?)\n- Error (if any)\n- Created / Updated timestamps\n\nThe test script automatically detects status changes and prints stage transitions."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Increment poll count",
              "let count = parseInt(pm.environment.get('pollCount') || '0');",
              "count++;",
              "pm.environment.set('pollCount', count.toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ─── Poll Project Status Tests ───",
              "",
              "const res = pm.response.json();",
              "const p = res.data;",
              "const pollNum = parseInt(pm.environment.get('pollCount') || '1');",
              "const prevStatus = pm.environment.get('lastStatus') || 'PENDING';",
              "const prevProgress = parseInt(pm.environment.get('lastProgress') || '0');",
              "",
              "pm.test('✅ Poll response (200)', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// ─── Stage Name Mapping ───",
              "function getStageLabel(progress) {",
              "    if (progress <= 0) return 'Queued';",
              "    if (progress <= 5) return 'Initializing project...';",
              "    if (progress <= 15) return 'Analyzing prompt...';",
              "    if (progress <= 20) return 'Generating Blueprint...';",
              "    if (progress <= 30) return 'Validating Blueprint...';",
              "    if (progress <= 40) return 'Generating Components...';",
              "    if (progress <= 50) return 'Planning Layout...';",
              "    if (progress <= 60) return 'Planning 3D Scene...';",
              "    if (progress <= 65) return 'Building React Project...';",
              "    if (progress <= 80) return 'Writing Files...';",
              "    if (progress <= 90) return 'Running npm install...';",
              "    if (progress <= 94) return 'Running Build Verification...';",
              "    if (progress <= 97) return 'Build Verification Complete';",
              "    if (progress <= 99) return 'Creating ZIP...';",
              "    return 'Finalizing...';",
              "}",
              "",
              "// ─── Detect status change ───",
              "const statusChanged = (p.status !== prevStatus);",
              "const progressChanged = (p.progress !== prevProgress);",
              "",
              "if (statusChanged || progressChanged) {",
              "    console.log('');",
              "    console.log('↓');",
              "    console.log(p.status + ' (' + p.progress + '%)');",
              "    console.log(getStageLabel(p.progress));",
              "    console.log('');",
              "}",
              "",
              "// ─── Detailed status output ───",
              "console.log('┌─ Poll #' + pollNum + ' ─────────────────────────────────┐');",
              "console.log('│  Project ID:    ' + p._id);",
              "console.log('│  Status:        ' + p.status);",
              "console.log('│  Progress:      ' + p.progress + '%');",
              "console.log('│  Stage:         ' + getStageLabel(p.progress));",
              "console.log('│  Created:       ' + p.createdAt);",
              "console.log('│  Updated:       ' + p.updatedAt);",
              "console.log('│  Build Status:  ' + (p.buildStatus || 'N/A'));",
              "console.log('│  Blueprint:     ' + (p.blueprint ? '✅ Present' : '⏳ Pending'));",
              "console.log('│  ZIP Artifact:  ' + (p.artifact ? '✅ ' + (p.artifact.zipFileName || 'Ready') : '⏳ Pending'));",
              "console.log('│  Error:         ' + (p.error?.message || 'None'));",
              "console.log('└────────────────────────────────────────────┘');",
              "",
              "// ─── Progress validation ───",
              "if (progressChanged && p.progress > 0) {",
              "    pm.test('✅ Progress increased: ' + prevProgress + '% → ' + p.progress + '%', () => {",
              "        pm.expect(p.progress).to.be.at.least(prevProgress);",
              "    });",
              "}",
              "",
              "// ─── Status transition validation ───",
              "const validTransitions = {",
              "    'PENDING': ['PROCESSING', 'FAILED'],",
              "    'PROCESSING': ['PROCESSING', 'REPAIRING', 'BUILDING', 'COMPLETED', 'FAILED'],",
              "    'REPAIRING': ['PROCESSING', 'BUILDING', 'COMPLETED', 'FAILED'],",
              "    'BUILDING': ['COMPLETED', 'FAILED']",
              "};",
              "",
              "if (statusChanged && prevStatus !== p.status) {",
              "    const allowed = validTransitions[prevStatus] || [];",
              "    pm.test('✅ Valid status transition: ' + prevStatus + ' → ' + p.status, () => {",
              "        pm.expect(allowed).to.include(p.status);",
              "    });",
              "}",
              "",
              "// ─── Update tracking state ───",
              "pm.environment.set('lastStatus', p.status);",
              "pm.environment.set('lastProgress', p.progress.toString());",
              "",
              "// ─── Terminal states ───",
              "if (p.status === 'COMPLETED') {",
              "    pm.test('✅ Final status is COMPLETED', () => {",
              "        pm.expect(p.status).to.equal('COMPLETED');",
              "    });",
              "",
              "    pm.test('✅ Progress is 100%', () => {",
              "        pm.expect(p.progress).to.equal(100);",
              "    });",
              "",
              "    pm.test('✅ Build status is SUCCESS', () => {",
              "        pm.expect(p.buildStatus).to.equal('SUCCESS');",
              "    });",
              "",
              "    if (p.artifact) {",
              "        pm.test('✅ ZIP artifact exists', () => {",
              "            pm.expect(p.artifact).to.be.an('object');",
              "            pm.expect(p.artifact.zipPath).to.be.a('string');",
              "        });",
              "        pm.environment.set('zipPath', p.artifact.zipPath || '');",
              "        pm.environment.set('zipFileName', p.artifact.zipFileName || '');",
              "    }",
              "",
              "    if (p.blueprint) {",
              "        pm.test('✅ Blueprint exists', () => {",
              "            pm.expect(p.blueprint).to.be.an('object');",
              "        });",
              "    }",
              "",
              "    console.log('');",
              "    console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "    console.log('🎉 GENERATION COMPLETE!');",
              "    console.log('');",
              "    console.log('  Status:       COMPLETED ✅');",
              "    console.log('  Progress:     100%');",
              "    console.log('  Build:        ' + p.buildStatus);",
              "    console.log('  ZIP File:     ' + (p.artifact?.zipFileName || 'N/A'));",
              "    console.log('  ZIP Path:     ' + (p.artifact?.zipPath || 'N/A'));",
              "    console.log('  ZIP Size:     ' + (p.artifact?.zipSize ? (p.artifact.zipSize / 1024).toFixed(1) + ' KB' : 'N/A'));",
              "    console.log('  Started:      ' + (p.startedAt || 'N/A'));",
              "    console.log('  Completed:    ' + (p.completedAt || 'N/A'));",
              "    console.log('  Poll Count:   ' + pollNum);",
              "    console.log('');",
              "    console.log('  ✅ Pipeline finished. Stop polling.');",
              "    console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "",
              "} else if (p.status === 'FAILED') {",
              "    pm.test('❌ Project FAILED', () => {",
              "        pm.expect.fail('Project generation failed: ' + (p.error?.message || 'Unknown'));",
              "    });",
              "",
              "    console.log('');",
              "    console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "    console.log('❌ GENERATION FAILED');",
              "    console.log('');",
              "    console.log('  Status:       FAILED');",
              "    console.log('  Progress:     ' + p.progress + '%');",
              "    console.log('  Failed Stage: ' + (p.failedStage || 'N/A'));",
              "    console.log('  Error:        ' + (p.error?.message || 'N/A'));",
              "    console.log('  Error Type:   ' + (p.error?.errorType || 'N/A'));",
              "    console.log('  Error Code:   ' + (p.error?.code || 'N/A'));",
              "    console.log('  Build Status: ' + (p.buildStatus || 'N/A'));",
              "    console.log('  Build Logs:   ' + (p.buildLogs ? 'Available' : 'N/A'));",
              "    console.log('  Poll Count:   ' + pollNum);",
              "    console.log('');",
              "    console.log('  ❌ Pipeline failed. Stop polling.');",
              "    console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "} else {",
              "    // Still in progress — continue polling",
              "    pm.test('⏳ Generation in progress (' + p.progress + '%)', () => {",
              "        pm.expect(['PENDING', 'PROCESSING', 'REPAIRING', 'BUILDING']).to.include(p.status);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "9. Verify ZIP Artifact",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}"]
        },
        "description": "## Verify the completed project has a ZIP artifact\n\n**Method:** GET  \n**URL:** `{{baseUrl}}/api/projects/{{projectId}}`  \n**Auth:** Bearer `{{jwt}}`  \n\nRun this AFTER polling shows COMPLETED.  \nThis step verifies the ZIP artifact metadata exists in the project document.\n\n**Expected:** `artifact.zipPath` should point to a valid file path on the server filesystem.\n\n> **Note:** The current backend does not expose a `/download` HTTP endpoint.  \n> The ZIP is stored on the server's filesystem at `artifact.zipPath`.  \n> To download, you would need either:\n> - Direct filesystem access to the server\n> - A static file serving route (not yet implemented)\n> - An S3/cloud storage URL (not yet implemented)"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ─── Verify ZIP Artifact Tests ───",
              "",
              "const res = pm.response.json();",
              "const p = res.data;",
              "",
              "pm.test('✅ Project retrieved (200)', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('✅ Status is COMPLETED', () => {",
              "    pm.expect(p.status).to.equal('COMPLETED');",
              "});",
              "",
              "pm.test('✅ Artifact object exists', () => {",
              "    pm.expect(p.artifact).to.be.an('object');",
              "});",
              "",
              "if (p.artifact) {",
              "    pm.test('✅ ZIP path exists', () => {",
              "        pm.expect(p.artifact.zipPath).to.be.a('string').and.not.empty;",
              "    });",
              "",
              "    pm.test('✅ ZIP filename exists', () => {",
              "        pm.expect(p.artifact.zipFileName).to.be.a('string').and.not.empty;",
              "    });",
              "",
              "    pm.test('✅ ZIP size is positive', () => {",
              "        pm.expect(p.artifact.zipSize).to.be.a('number').and.to.be.greaterThan(0);",
              "    });",
              "",
              "    pm.environment.set('zipPath', p.artifact.zipPath);",
              "    pm.environment.set('zipFileName', p.artifact.zipFileName);",
              "}",
              "",
              "pm.test('✅ Blueprint was stored', () => {",
              "    pm.expect(p.blueprint).to.be.an('object');",
              "});",
              "",
              "pm.test('✅ Build status is SUCCESS', () => {",
              "    pm.expect(p.buildStatus).to.equal('SUCCESS');",
              "});",
              "",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('🟢 ZIP ARTIFACT VERIFICATION');",
              "console.log('');",
              "console.log('  Project ID:    ' + p._id);",
              "console.log('  Status:        ' + p.status);",
              "console.log('  Build Status:  ' + p.buildStatus);",
              "console.log('');",
              "console.log('  ── Artifact ──');",
              "console.log('  ZIP Path:      ' + (p.artifact?.zipPath || 'MISSING'));",
              "console.log('  ZIP File:      ' + (p.artifact?.zipFileName || 'MISSING'));",
              "console.log('  ZIP Size:      ' + (p.artifact?.zipSize ? (p.artifact.zipSize / 1024).toFixed(1) + ' KB' : 'MISSING'));",
              "console.log('  Generated At:  ' + (p.artifact?.generatedAt || 'MISSING'));",
              "console.log('');",
              "console.log('  ── Blueprint ──');",
              "console.log('  Version:       ' + (p.blueprint?.version || 'N/A'));",
              "console.log('  Brand Name:    ' + (p.blueprint?.brand?.name || p.blueprint?.website_name || 'N/A'));",
              "console.log('  Sections:      ' + (p.blueprint?.sections?.length || 'N/A'));",
              "console.log('');",
              "console.log('  ── Repair ──');",
              "console.log('  Attempts:      ' + (p.repair?.totalAttempts || 0));",
              "console.log('  Success:       ' + (p.repair?.success !== undefined ? p.repair.success : 'N/A'));",
              "console.log('');",
              "console.log('  ── Timing ──');",
              "console.log('  Started:       ' + (p.startedAt || 'N/A'));",
              "console.log('  Completed:     ' + (p.completedAt || 'N/A'));",
              "console.log('  Build Started: ' + (p.buildStartedAt || 'N/A'));",
              "console.log('  Build Done:    ' + (p.buildCompletedAt || 'N/A'));",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('');",
              "console.log('📁 To access the ZIP file, check the server filesystem at:');",
              "console.log('   ' + (p.artifact?.zipPath || 'N/A'));",
              "console.log('');"
            ]
          }
        }
      ],
      "response": []
    },
