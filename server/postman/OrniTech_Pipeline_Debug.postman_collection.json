              "});",
              "",
              "pm.test('✅ User object returned with id', () => {",
              "    pm.expect(res.user).to.have.property('id');",
              "    pm.expect(res.user.id).to.be.a('string').and.not.empty;",
              "});",
              "",
              "// Save JWT and userId (overwrite any from signup)",
              "pm.environment.set('jwt', res.token);",
              "pm.environment.set('userId', res.user.id);",
              "",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');",
              "console.log('🟢 LOGIN COMPLETE');",
              "console.log('  User ID:    ' + res.user.id);",
              "console.log('  Name:       ' + res.user.name);",
              "console.log('  Email:      ' + res.user.email);",
              "console.log('  Last Login: ' + res.user.lastLogin);",
              "console.log('  JWT:        ' + res.token.substring(0, 30) + '...');",
              "console.log('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');"
            ]
          }
        }
      ],
      "response": []
    },
